<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<VersionPrefix>1.3.0</VersionPrefix>
		<VersionSuffix></VersionSuffix>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>WSCT.GlobalPlatform</PackageId>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>
			A library implementing some parts of GlobalPlatform for the WSCT framework.
		</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="WSCT.Core" />
	</ItemGroup>

</Project>
