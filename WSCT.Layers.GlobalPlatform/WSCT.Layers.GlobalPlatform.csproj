<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<VersionPrefix>1.0.0</VersionPrefix>
		<VersionSuffix>wip</VersionSuffix>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>WSCT.Layers.GlobalPlatform</PackageId>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>Layers.GlobalPlatform</AssemblyName>
		<Description>Layer GlobalPlatform for WSCT.</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WSCT.GlobalPlatform\WSCT.GlobalPlatform.csproj" />
	</ItemGroup>

</Project>
