<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Stack.Channel.xml" />
    <None Remove="Stack.Context.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Stack.Channel.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Stack.Context.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WSCT.GUI" Version="6.2.1" />
    <PackageReference Include="WSCT.Plugin.ISO7816Tools" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WSCT.GUI.Plugins.GlobalPlatform\WSCT.GUI.Plugins.GlobalPlatform.csproj" />
  </ItemGroup>

</Project>